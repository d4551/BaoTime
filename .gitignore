# Local machine configuration — never commit (holds SDK path; must never hold credentials)
local.properties

# Gradle
.gradle/
**/build/

# IDE
.idea/
*.iml
.kotlin/

# OS
.DS_Store

# Tool session state
.mimosa/

# Local caches and machine-specific output
node_modules/
dist/

# Secrets and signing material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Generated test evidence and language caches
__pycache__/
*.py[cod]
# Exclude evidence contents, not the directory itself: git never descends into an
# excluded directory, so a negation below it could not take effect.
/evidence/*
# Audit reports are deliverables, not scratch output: keep them reviewable in git.
!/evidence/axe-2026-11-13/
!/evidence/device-2026-11-13/
!/evidence/burndown-2026-11-13/

# Loop-discipline working ledger
LOOP-STATE.md
/evidence
